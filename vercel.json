{
  "version": 2,
  "buildCommand": "npm install && npm run build && cd server && npm install && npx prisma generate && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.cjs": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/storage/(.*)",
      "destination": "/api/index.cjs"
    },
    {
      "source": "/((?!assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
