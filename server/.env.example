# ── Application ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
PORT=3000
NODE_ENV=development

# Origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Database ────────────────────────────────────────────────────────────────
# Supabase POOLED connection (PgBouncer, transaction mode, port 6543).
# `pgbouncer=true` disables prepared statements — without it you get
# intermittent "prepared statement already exists" errors under load.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT connection (port 5432). Required for `prisma db pull` / `migrate`,
# which cannot run through the transaction pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Must match Laravel's BCRYPT_ROUNDS so hashes stay interchangeable.
BCRYPT_ROUNDS=12

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="FamilyLocker"

# ── File storage ────────────────────────────────────────────────────────────
# `local` writes to ../storage/app/public (byte-compatible with Laravel).
# `supabase` uses Supabase Storage — REQUIRED in production, because Vercel's
# filesystem is ephemeral and local uploads do not survive between invocations.
STORAGE_DRIVER=local
# STORAGE_ROOT=/absolute/path/to/storage/app/public
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=public

# ── Cron ────────────────────────────────────────────────────────────────────
# Shared secret Vercel sends as a bearer token to GET /api/cron/reminders.
CRON_SECRET=

# ── Brevo (transactional email) ─────────────────────────────────────────────
# When BREVO_API_KEY is set, mail goes out over Brevo's HTTP API and the SMTP
# settings above are ignored. Free tier: 300 emails/day.
#
#   1. Sign up at brevo.com
#   2. SMTP & API -> API Keys -> Generate a new API key  (an API key, not an
#      SMTP key)
#   3. Senders, Domains & Dedicated IPs -> Senders -> add and verify the
#      address you put in MAIL_FROM_ADDRESS. Brevo emails you a confirmation
#      link; an unverified sender is rejected outright.
#
# SECURITY: this is a server-only secret. It must never be placed in a VITE_*
# variable or referenced from resources/js — anything prefixed VITE_ is
# compiled into the browser bundle and is public.
BREVO_API_KEY=

# ── Registration OTP ────────────────────────────────────────────────────────
REGISTRATION_OTP_TTL_MINUTES=5
REGISTRATION_OTP_MAX_ATTEMPTS=5
REGISTRATION_OTP_RESEND_SECONDS=60
