// Prisma schema mapped onto the EXISTING Laravel/Supabase tables.
// Nothing here creates or alters schema — `prisma migrate` is intentionally
// not used. Verify against the live DB with `npx prisma db pull`.
//
// Naming: DB stays snake_case (Laravel's convention); Prisma fields stay
// camelCase in code via @map. The API serializer converts back to snake_case
// so response bodies remain byte-compatible with the Laravel API.

generator client {
  provider = "prisma-client-js"
  // Vercel's Node runtime is RHEL-based, not the local glibc target. Without
  // this the deployed function fails at runtime with "Query engine binary for
  // current platform could not be found" — the engine is chosen at generate
  // time, so it must be declared here rather than fixed after deploy.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Introspection and migrations cannot run through PgBouncer's transaction
  // pooler; they use the direct connection on port 5432.
  directUrl = env("DIRECT_URL")
}

model User {
  id              BigInt    @id @default(autoincrement())
  familyId        BigInt?   @map("family_id")
  role            String    @default("member") @db.VarChar(255)
  avatar          String?   @db.VarChar(255)
  phone           String?   @db.VarChar(255)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  relation        String?   @db.VarChar(255)
  name            String    @db.VarChar(255)
  email           String?   @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(0)
  otpCode         String?   @map("otp_code") @db.VarChar(6)
  otpExpiresAt    DateTime? @map("otp_expires_at") @db.Timestamp(0)
  password        String    @db.VarChar(255)
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)

  family           Family?         @relation("FamilyMembers", fields: [familyId], references: [id])
  createdFamilies  Family[]        @relation("FamilyCreator")
  documents        Document[]
  expenses         Expense[]
  medicalRecords   MedicalRecord[]
  appointments     Appointment[]
  albums           Album[]
  photos           Photo[]
  bills            Bill[]
  createdTasks     Task[]          @relation("TaskCreator")
  assignedTasks    Task[]          @relation("TaskAssignee")
  activityLogs     ActivityLog[]
  createdReminders Reminder[]      @relation("ReminderCreator")

  @@map("users")
}

model Family {
  id          BigInt    @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?
  avatar      String?   @db.VarChar(255)
  createdBy   BigInt    @map("created_by")
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  // created_by has no FK constraint in the Laravel migration and is briefly 0
  // during registration, so it is deliberately a soft relation.
  creator        User?             @relation("FamilyCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members        User[]            @relation("FamilyMembers")
  documents      Document[]
  expenses       Expense[]
  categories     ExpenseCategory[]
  medicalRecords MedicalRecord[]
  medicines      Medicine[]
  appointments   Appointment[]
  albums         Album[]
  bills          Bill[]
  tasks          Task[]
  activityLogs   ActivityLog[]
  reminders      Reminder[]

  @@map("families")
}

model Document {
  id                 BigInt    @id @default(autoincrement())
  familyId           BigInt    @map("family_id")
  uploadedBy         BigInt    @map("uploaded_by")
  title              String    @db.VarChar(255)
  type               String    @db.VarChar(255)
  documentNumber     String?   @map("document_number") @db.VarChar(255)
  memberName         String    @map("member_name") @db.VarChar(255)
  issueDate          DateTime? @map("issue_date") @db.Date
  expiryDate         DateTime? @map("expiry_date") @db.Date
  filePath           String?   @map("file_path") @db.VarChar(255)
  fileName           String?   @map("file_name") @db.VarChar(255)
  notes              String?
  isReminderEnabled  Boolean   @default(true) @map("is_reminder_enabled")
  reminderDaysBefore Int       @default(30) @map("reminder_days_before")
  createdAt          DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @map("updated_at") @db.Timestamp(0)

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("documents")
}

model ExpenseCategory {
  id        BigInt    @id @default(autoincrement())
  familyId  BigInt    @map("family_id")
  name      String    @db.VarChar(255)
  icon      String?   @db.VarChar(255)
  color     String?   @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            BigInt    @id @default(autoincrement())
  familyId      BigInt    @map("family_id")
  userId        BigInt    @map("user_id")
  categoryId    BigInt?   @map("category_id")
  title         String    @db.VarChar(255)
  amount        Decimal   @db.Decimal(12, 2)
  date          DateTime  @db.Date
  description   String?
  paymentMethod String    @default("cash") @map("payment_method") @db.VarChar(255)
  receiptPath   String?   @map("receipt_path") @db.VarChar(255)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  family   Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model MedicalRecord {
  id           BigInt    @id @default(autoincrement())
  familyId     BigInt    @map("family_id")
  userId       BigInt    @map("user_id")
  memberName   String    @map("member_name") @db.VarChar(255)
  type         String    @db.VarChar(255)
  title        String    @db.VarChar(255)
  doctorName   String?   @map("doctor_name") @db.VarChar(255)
  hospitalName String?   @map("hospital_name") @db.VarChar(255)
  date         DateTime  @db.Date
  diagnosis    String?
  notes        String?
  filePath     String?   @map("file_path") @db.VarChar(255)
  fileName     String?   @map("file_name") @db.VarChar(255)
  createdAt    DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(0)

  family    Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@map("medical_records")
}

model Medicine {
  id                 BigInt    @id @default(autoincrement())
  medicalRecordId    BigInt?   @map("medical_record_id")
  familyId           BigInt    @map("family_id")
  memberName         String    @map("member_name") @db.VarChar(255)
  name               String    @db.VarChar(255)
  dosage             String?   @db.VarChar(255)
  frequency          String?   @db.VarChar(255)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  isActive           Boolean   @default(true) @map("is_active")
  notes              String?
  imagePath          String?   @map("image_path") @db.VarChar(255)
  notifyOnCompletion Boolean   @default(false) @map("notify_on_completion")
  createdAt          DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @map("updated_at") @db.Timestamp(0)

  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("medicines")
}

model Appointment {
  id                 BigInt    @id @default(autoincrement())
  familyId           BigInt    @map("family_id")
  userId             BigInt    @map("user_id")
  memberName         String    @map("member_name") @db.VarChar(255)
  doctorName         String    @map("doctor_name") @db.VarChar(255)
  specialty          String?   @db.VarChar(255)
  date               DateTime  @db.Date
  time               DateTime? @db.Time(0)
  location           String?   @db.VarChar(255)
  notes              String?
  status             String    @default("scheduled") @db.VarChar(255)
  remindDaysBefore   Int       @default(1) @map("remind_days_before") @db.SmallInt
  notificationSentAt DateTime? @map("notification_sent_at") @db.Date
  createdAt          DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @map("updated_at") @db.Timestamp(0)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Album {
  id          BigInt    @id @default(autoincrement())
  familyId    BigInt    @map("family_id")
  userId      BigInt    @map("user_id")
  name        String    @db.VarChar(255)
  description String?
  coverPhoto  String?   @map("cover_photo") @db.VarChar(255)
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@map("albums")
}

model Photo {
  id        BigInt    @id @default(autoincrement())
  albumId   BigInt    @map("album_id")
  userId    BigInt    @map("user_id")
  title     String?   @db.VarChar(255)
  filePath  String    @map("file_path") @db.VarChar(255)
  fileName  String    @map("file_name") @db.VarChar(255)
  fileSize  String?   @map("file_size") @db.VarChar(255)
  caption   String?
  takenAt   DateTime? @map("taken_at") @db.Date
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Bill {
  id              BigInt    @id @default(autoincrement())
  familyId        BigInt    @map("family_id")
  userId          BigInt    @map("user_id")
  name            String    @db.VarChar(255)
  category        String    @db.VarChar(255)
  amount          Decimal   @db.Decimal(12, 2)
  dueDate         DateTime  @map("due_date") @db.Date
  paidDate        DateTime? @map("paid_date") @db.Date
  status          String    @default("pending") @db.VarChar(255)
  isRecurring     Boolean   @default(false) @map("is_recurring")
  recurringPeriod String?   @map("recurring_period") @db.VarChar(255)
  provider        String?   @db.VarChar(255)
  notes           String?
  receiptPath     String?   @map("receipt_path") @db.VarChar(255)
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bills")
}

model Task {
  id          BigInt    @id @default(autoincrement())
  familyId    BigInt    @map("family_id")
  createdBy   BigInt    @map("created_by")
  assignedTo  BigInt?   @map("assigned_to")
  title       String    @db.VarChar(255)
  description String?
  dueDate     DateTime? @map("due_date") @db.Date
  priority    String    @default("medium") @db.VarChar(255)
  status      String    @default("pending") @db.VarChar(255)
  category    String?   @db.VarChar(255)
  completedAt DateTime? @map("completed_at") @db.Timestamp(0)
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator  User   @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model ActivityLog {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  familyId    BigInt    @map("family_id")
  module      String    @db.VarChar(255)
  action      String    @db.VarChar(255)
  description String    @db.VarChar(255)
  meta        Json?     @db.Json
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Reminder {
  id                 BigInt    @id @default(autoincrement())
  familyId           BigInt    @map("family_id")
  createdBy          BigInt    @map("created_by")
  title              String    @db.VarChar(255)
  type               String    @default("other") @db.VarChar(255)
  occasionDate       DateTime  @map("occasion_date") @db.Date
  recursYearly       Boolean   @default(true) @map("recurs_yearly")
  remindDaysBefore   Int       @default(7) @map("remind_days_before")
  description        String?
  isActive           Boolean   @default(true) @map("is_active")
  notificationSentAt DateTime? @map("notification_sent_at") @db.Date
  createdAt          DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime? @map("updated_at") @db.Timestamp(0)

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User   @relation("ReminderCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("reminders")
}

/// Sanctum-compatible token store. Kept so tokens issued by Laravel keep
/// working during the strangler cutover, and vice versa.
model PersonalAccessToken {
  id            BigInt    @id @default(autoincrement())
  tokenableType String    @map("tokenable_type") @db.VarChar(255)
  tokenableId   BigInt    @map("tokenable_id")
  name          String
  token         String    @unique @db.VarChar(64)
  abilities     String?
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamp(0)
  expiresAt     DateTime? @map("expires_at") @db.Timestamp(0)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([tokenableType, tokenableId])
  @@map("personal_access_tokens")
}

/// A sign-up held between "Create Account" and successful OTP entry.
/// No `users` row exists until the code is verified, so an abandoned or
/// mistyped registration leaves no account behind and frees the address.
model PendingRegistration {
  id           BigInt    @id @default(autoincrement())
  /// Opaque handle held by the browser; identifies the sign-up without
  /// exposing the row id.
  token        String    @unique @db.VarChar(64)
  name         String    @db.VarChar(255)
  familyName   String    @map("family_name") @db.VarChar(255)
  email        String    @unique @db.VarChar(255)
  /// Already bcrypt-hashed by the API — plaintext is never stored.
  password     String    @db.VarChar(255)
  otpCode      String    @map("otp_code") @db.VarChar(6)
  otpExpiresAt DateTime  @map("otp_expires_at") @db.Timestamp(0)
  attempts     Int       @default(0) @db.SmallInt
  lastSentAt   DateTime? @map("last_sent_at") @db.Timestamp(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(0)

  @@index([otpExpiresAt])
  @@map("pending_registrations")
}
